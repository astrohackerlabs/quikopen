{
  "name": "@astrohacker/quikopen",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.5",
  "scripts": {
    "dev": "react-router dev --port 3465 --host 127.0.0.1",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "cli": "bun cli.ts",
    "build:quikopen": "bun scripts/build-quikopen.ts",
    "test": "bun test ./app",
    "test:integration": "bun --no-env-file test test/*.integration.test.ts",
    "test:browser": "bun --no-env-file test test/native-runtime.integration.test.ts --test-name-pattern browser",
    "typecheck": "react-router typegen && tsc --noEmit -p tsconfig.browser.json && tsc --noEmit -p tsconfig.runtime.json",
    "lint": "oxlint --config ../../../oxlint.config.ts --deny-warnings .",
    "lint:fix": "oxlint --config ../../../oxlint.config.ts --deny-warnings --fix .",
    "format": "prettier --ignore-path ../../../.prettierignore --ignore-path .prettierignore --write .",
    "format:check": "prettier --ignore-path ../../../.prettierignore --ignore-path .prettierignore --check ."
  },
  "bin": {
    "quikopen": "./dist/quikopen"
  },
  "dependencies": {
    "@astrohacker/ui": "workspace:*",
    "@react-router/node": "^8",
    "@react-router/serve": "^8",
    "@webbuf/numbers": "workspace:^",
    "@webbuf/rw": "workspace:^",
    "@webbuf/webbuf": "workspace:^",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isbot": "^5.1.36",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "^8",
    "@tailwindcss/vite": "^4.2.2",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "prettier": "3.9.6",
    "tailwindcss": "^4.2.2",
    "typescript": "7.0.2",
    "vite": "^8.2.2",
    "vite-tsconfig-paths": "^6",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier-plugin-tailwindcss": "0.8.1"
  }
}