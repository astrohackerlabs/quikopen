{
  "name": "@webbuf/webbuf",
  "version": "4.0.1",
  "description": "Rust/WASM optimized buffers for the web, node.js, deno, and bun.",
  "repository": {
    "type": "git",
    "url": "https://github.com/astrohackerlabs/webbuf"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "clean": "rimraf dist",
    "benchmark": "vitest --config vitest.benchmark.config.ts run",
    "test": "vitest --run --dir test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.runtime.json",
    "lint": "oxlint --config ../../../oxlint.config.ts --deny-warnings .",
    "format": "prettier --ignore-path ../../../.prettierignore --ignore-path .prettierignore --write . --ignore-path ../.prettierignore",
    "format:check": "prettier --ignore-path ../../../.prettierignore --ignore-path .prettierignore --check . --ignore-path ../.prettierignore",
    "fix": "bun run typecheck && bun run lint:fix && bun run format",
    "sync:from-rust": "cp -r ../../rs/webbuf/build/bundler/* src/rs-webbuf-bundler/",
    "build": "bun run build:wasm && bun run build:typescript",
    "build:bundler-to-inline-base64": "cp -r src/rs-webbuf-bundler/* src/rs-webbuf-inline-base64/",
    "build:inline-wasm": "tsx build-inline-wasm.ts",
    "build:wasm": "bun run build:bundler-to-inline-base64 && bun run build:inline-wasm",
    "build:typescript": "tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run clean && bun run build",
    "lint:fix": "oxlint --config ../../../oxlint.config.ts --deny-warnings --fix ."
  },
  "engines": {
    "node": ">=20.8.0"
  },
  "packageManager": "bun@1.4.0",
  "keywords": [
    "buffer",
    "base64",
    "hex",
    "uint256",
    "int256",
    "uint128",
    "int128",
    "rust",
    "wasm"
  ],
  "author": "Astrohacker",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "26.3.0",
    "buffer": "^6.0.3",
    "prettier": "3.9.6",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001"
  }
}
